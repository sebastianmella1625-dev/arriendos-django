# Copia este archivo a .env y completa los valores. El .env NO se sube al repositorio.

# Clave secreta de Django. Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# True solo en desarrollo local. Si se omite, queda en False.
DEBUG=True

# Hosts permitidos, separados por coma (necesario si DEBUG=False). Ej: midominio.cl,www.midominio.cl
ALLOWED_HOSTS=

# Base de datos PostgreSQL
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
